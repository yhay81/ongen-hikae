{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ongen-hikae",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "ongen-hikae.yhay81.com",
      "custom_domain": true,
    },
  ],
  "triggers": {
    "crons": ["13 20 * * *"],
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ongen-hikae",
      "database_id": "07ef0c26-d960-46aa-8742-514b76fcfcbc",
      "migrations_dir": "migrations",
    },
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
  },
}
